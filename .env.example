# Адрес auth-сервиса — отсюда wallet-api тянет публичные ключи (GET
# /.well-known/jwks.json) для проверки подписи access-токена. Никакого
# общего секрета заводить не нужно (тот же приём, что в wallet-gateway —
# см. его README, "Как убрали общий секрет").
AUTH_SERVICE_URL=http://127.0.0.1:8080

# СВОЯ, отдельная от auth-сервиса база И РОЛЬ — см. README, "Своя БД".
# Инстанс Postgres может быть тем же самым, что у auth-сервиса
# (localhost:5432 и там, и там — это нормально), но логин/пароль здесь
# ДОЛЖНЫ отличаться от DATABASE_URL google-auth — не только имя базы. Общая
# роль на разные базы изоляцию только имитирует: та роль обычно и есть
# владелец базы auth-сервиса, скомпрометированный wallet-api получил бы
# доступ и туда. Саму роль и базу нужно создать заранее (например,
# `CREATE ROLE wallet_api LOGIN PASSWORD '...'; CREATE DATABASE wallet_api
# OWNER wallet_api;`) — таблицу внутри неё (wallets) сервис создаст сам при
# старте. В Docker/compose это делается само отдельной ролью-мигратором —
# см. infra/db/init-db.sh в корне репозитория и infra/db/README.md, "Три роли": роль,
# которой подключается сам сервис (см. DATABASE_URL ниже), намеренно без
# прав DDL — таблицу wallets сервис теперь только проверяет, не создаёт.
DATABASE_URL=postgresql://wallet_api:password@localhost:5432/wallet_api

# Сколько соединений держать одновременно в пуле (см. src/db.hpp::Pool) — по
# прямому запросу, взамен единственного соединения на весь процесс: сервис
# синка уже даёт несколько одновременных запросов с одного устройства (push +
# подгрузка блобов), не считая несколько устройств одного леджера сразу. 8 по
# умолчанию — тот же дефолт, что REPORTS_DB_POOL_SIZE у wallet-report.
# DATABASE_POOL_SIZE=8

PORT=8082
# 127.0.0.1 — только локально. На Linux-сервере, слушающем внешние
# подключения, поставьте HOST=0.0.0.0.
HOST=127.0.0.1

# Куда писать логи — папка, внутри неё файл на каждый день
# ("<LOG_DIR>/2026-08-25-wallet-api.log", ротация — по смене даты). По
# умолчанию (если не задано):
#   Windows — папка "logs" в рабочей директории;
#   Linux/Docker — stdout/stderr.
# LOG_DIR=var/log/wallet-api
# LOG_DIR=stdout

# true/1 — писать в лог ещё и значения параметров SQL-запросов ($1, $2, ...),
# не только сам текст запроса (см. README, "Логирование"). По умолчанию
# выключено: параметры — произвольные данные приложения, включайте только
# для локальной отладки.
# LOG_SQL_PARAMS=true

# Доп. имена параметров (через запятую), чьи значения exec() маскирует "***"
# в логе при LOG_SQL_PARAMS=true — расширяет встроенный набор
# password/client_secret/refresh_token/access_token/id_token/token/secret
# (см. builtin_mask_param_names() в src/db.cpp), а не заменяет его.
# LOG_SQL_MASK_PARAMS=api_key,pin

# Чистка удалённых строк синка (tombstone) — см. README, "Срок хранения
# удалённых строк". off по умолчанию: включать (on) только после релиза
# Android-версии с вычисткой при старте с нуля (change
# purge-synced-tombstones). Подтверждения устройств пишутся всегда.
# SYNC_TOMBSTONE_PURGE=off
# Устройство без GET /sync/pull дольше этого срока (дней) не держит чистку.
# SYNC_TOMBSTONE_DEVICE_TTL_DAYS=90
